{
  "name": "pathvn-elearning",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "PathVN - Your learning path from Grade 1 to 12. E-learning platform with theory, quiz, flashcard, progress tracking and admin portal",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "seed": "node server/seed.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.14",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.5"
  }
}
